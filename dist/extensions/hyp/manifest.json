{
  "manifest_version": 3,
  "name": "ASM Çözüm Yardımcısı",
  "version": "1.0.0",
  "key": "",
  "description": "Tarama/İzleme hızlandırma + Anlık HYP hedefleri + Davet / SMS otomasyonu + KHT Hesaplama ve daha fazlaası...",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://sina.saglik.gov.tr/*",
    "https://hyp.saglik.gov.tr/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sina.saglik.gov.tr/*"
      ],
      "exclude_matches": [
        "https://sina.saglik.gov.tr/auth/*"
      ],
      "js": [
        "src/sina-interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://sina.saglik.gov.tr/*"
      ],
      "js": [
        "src/sina-content.js"
      ],
      "css": [
        "src/sina-panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hyp.saglik.gov.tr/*"
      ],
      "js": [
        "src/auth-ui.js",
        "src/hyp-content.js",
        "src/hyp-davet.js",
        "src/hyp-hizli.js"
      ],
      "css": [
        "src/hyp-panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/settings.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/settings.html", "src/settings.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
	"256": "icons/icon48.png"
  }
}